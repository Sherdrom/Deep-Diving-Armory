<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Libs>../../../.Tools/Refs</Libs>
    <DdaBin Condition="'$(DdaBin)' == ''">$(MSBuildThisFileDirectory)../../../bin</DdaBin>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>UnstableCompatibility.Tests</AssemblyName>
    <BuildTarget Condition="'$(BuildTarget)' == ''">Client</BuildTarget>
    <DefineConstants Condition="'$(BuildTarget)' == 'Client'">$(DefineConstants);CLIENT</DefineConstants>
    <DefineConstants Condition="'$(BuildTarget)' == 'Server'">$(DefineConstants);SERVER</DefineConstants>
    <Nullable>disable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <Reference Include="Barotrauma" HintPath="$(Libs)/Windows/Barotrauma.dll" Condition="'$(BuildTarget)' == 'Client'" />
    <Reference Include="DedicatedServer" HintPath="$(Libs)/Windows/DedicatedServer.dll" Condition="'$(BuildTarget)' == 'Server'" />
    <Reference Include="BarotraumaCore" HintPath="$(Libs)/Windows/BarotraumaCore.dll" />
    <Reference Include="MonoGame.Framework.Windows.NetStandard" HintPath="$(Libs)/MonoGame.Framework.Windows.NetStandard.dll" />
    <Reference Include="0Harmony" HintPath="$(Libs)/0Harmony.dll" />
    <Reference Include="Lidgren.NetStandard" HintPath="$(Libs)/Lidgren.NetStandard.dll" />
    <Reference Include="Farseer.NetStandard" HintPath="$(Libs)/Farseer.NetStandard.dll" />
    <Reference Include="XNATypes" HintPath="$(Libs)/XNATypes.dll" />
    <Reference Include="Deep-Diving-Armory$(BuildTarget)" HintPath="$(DdaBin)/Windows/$(BuildTarget)/Deep-Diving-Armory$(BuildTarget).dll" />
    <Using Include="Barotrauma" />
  </ItemGroup>
</Project>
