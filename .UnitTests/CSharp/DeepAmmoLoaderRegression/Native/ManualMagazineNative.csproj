<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><UseAppHost>false</UseAppHost>
    <TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <BuildTarget>Client</BuildTarget>
    <PlatformName Condition="$([MSBuild]::IsOSPlatform('OSX'))">Mac</PlatformName>
    <PlatformName Condition="$([MSBuild]::IsOSPlatform('Linux'))">Linux</PlatformName>
    <PlatformName Condition="'$(PlatformName)' == ''">Windows</PlatformName>
  </PropertyGroup>
  <Import Project="../../../../.AssemblyCSharpSource/DDACsSource/References.props" />
  <ItemGroup>
    <Reference Update="System.Collections.Immutable" Private="true" />
    <Reference Include="Deep-Diving-ArmoryClient" HintPath="../../../../bin/$(PlatformName)/Client/Deep-Diving-ArmoryClient.dll" Private="false" />
  </ItemGroup>
</Project>
