<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <RefPlatform Condition="$([MSBuild]::IsOSPlatform('OSX'))">OSX</RefPlatform>
    <RefPlatform Condition="$([MSBuild]::IsOSPlatform('Linux'))">Linux</RefPlatform>
    <RefPlatform Condition="'$(RefPlatform)' == ''">Windows</RefPlatform>
    <MonoGamePlatform>$(RefPlatform)</MonoGamePlatform>
    <MonoGamePlatform Condition="'$(RefPlatform)' == 'OSX'">MacOS</MonoGamePlatform>
    <Refs>../../../.Tools/Refs</Refs>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Collections.Immutable" HintPath="$(Refs)/System.Collections.Immutable.dll" />
    <Reference Include="Barotrauma"><HintPath>$(Refs)/$(RefPlatform)/Barotrauma.dll</HintPath></Reference>
    <Reference Include="BarotraumaCore"><HintPath>$(Refs)/$(RefPlatform)/BarotraumaCore.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Refs)/0Harmony.dll</HintPath></Reference>
    <Reference Include="MonoGame.Framework.$(MonoGamePlatform).NetStandard"><HintPath>$(Refs)/MonoGame.Framework.$(MonoGamePlatform).NetStandard.dll</HintPath></Reference>
    <Reference Include="Farseer.NetStandard"><HintPath>$(Refs)/Farseer.NetStandard.dll</HintPath></Reference>
    <Reference Include="Lidgren.NetStandard"><HintPath>$(Refs)/Lidgren.NetStandard.dll</HintPath></Reference>
    <Reference Include="XNATypes"><HintPath>$(Refs)/XNATypes.dll</HintPath></Reference>
  </ItemGroup>
</Project>
