<?xml version="1.0" encoding="utf-8"?>
<Randomevents>
<EventPrefabs>

<!-- 战无不休——N3 -->
    <ScriptedEvent identifier="deep_contract_never_ending_battle" commonness="150">
    <Label name="deep_contract_never_ending_battle_loop" />
      <!-- 使用深潜安全官，深潜医生作为特殊职业，方便统一给Affliction -->
      <TagAction criteria="jobidentifier:deep_securityofficer_enemy" tag="enemy" ContinueIfNoTargetsFound="true"  />
      <TagAction criteria="jobidentifier:deep_medicaldoctor_enemy" tag="enemy" ContinueIfNoTargetsFound="true" />

      <CountTargetsAction targettag="deep_balance_contract_never_ending_battle" MaxAmount="0">
          <Success>
            <StatusEffectAction targettag="enemy" >
                    <StatusEffect target="This" multiplyafflictionsbymaxvitality="true" comparison="and" stackable="false" setvalue="true" >
                    <Conditional deep_contract_never_ending_battle_detect="lt 0.5" />
                         <Affliction identifier="deep_contract_never_ending_battle_detect" strength="5" />
                    </StatusEffect>
            </StatusEffectAction>
            <WaitAction time="2" />
            <Goto name="deep_contract_never_ending_battle_loop" />
          </Success>
          <Failure>
          <WaitAction time="2" />
          <Goto name="deep_contract_never_ending_battle_loop" />
          </Failure>
      </CountTargetsAction>

    </ScriptedEvent>

    <!-- 画地为牢——N3 -->
    <ScriptedEvent identifier="deep_contract_draw_a_circle" commonness="150">
    <Label name="deep_contract_draw_a_circle" />
      <!-- 标记所有门 -->
      <TagAction criteria="itemidentifier:door" tag="targetdoor" submarinetype="Outpost" continueifnotargetsfound="true" />
      <TagAction criteria="itemidentifier:windoweddoor" tag="targetdoor" submarinetype="Outpost" continueifnotargetsfound="true" />
      <TagAction criteria="itemidentifier:doorwbuttons" tag="targetdoor" submarinetype="Outpost" continueifnotargetsfound="true" />
      <TagAction criteria="itemidentifier:windoweddoorwbuttons" tag="targetdoor" submarinetype="Outpost" continueifnotargetsfound="true" />
      <TagAction criteria="itemidentifier:hatch" tag="targetdoor" submarinetype="Outpost" continueifnotargetsfound="true" />
      <TagAction criteria="itemidentifier:hatchwbuttons" tag="targetdoor" submarinetype="Outpost" continueifnotargetsfound="true" />

      <CountTargetsAction targettag="deep_balance_contract_draw_a_circle" MaxAmount="0">
          <Success>
            <StatusEffectAction targettag="targetdoor" >
                    <StatusEffect target="This" comparison="and" stackable="false" setvalue="true" InvulnerabletoDamage="true" window="0.0,0.0,0.0,0.0" >
                    </StatusEffect>
            </StatusEffectAction>
          </Success>
          <Failure>
          <WaitAction time="2" />
          <Goto name="deep_contract_draw_a_circle" />
          </Failure>
      </CountTargetsAction>

    </ScriptedEvent>

