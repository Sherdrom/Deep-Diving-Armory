<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  Deep-Diving-Armory 正式槽位声明（三槽）
  ============================================================
  布局：第二行（ID 卡槽上方），从左到右依次为三个新槽位，横向吸附原版列，与下方槽位对齐：
    [弹挂 chestrig]=Card列左移2格(原版Head列)  [目镜 goggles]=原版Headset列  [头套 mask]=原版Card列
    align 字段 = 横向吸附目标（原版 InvSlotType 名）；col = 在吸附列基础上的偏移格数。
  图标：框架自动加载本包 UI/slot_<id>.png 作为各槽图标（128x128）。
  双端一致：主机与所有客机都必须启用同一份本文件。
-->
<DeepSlotExpandeds>

  <!-- ============ 弹挂槽 chestrig（bit 1024） ============
       匹配 DDA 全部 10 款普通胸挂（不能用 headset 标签——会误伤真耳机），
       它们当前占据 Headset（耳机）槽 → 迁入 1024 专属槽；
       align="Card" + col="0" = 直接吸附原版 ID 卡列——不经过 Bag 换算，
       本地 Default 布局与 BOT 互动视图（Left/Right 布局）下都精确落在 ID 卡正上方；
       row="1" + yoff="-12" = ID 卡上方一行（微调 -12px） -->
  <Slot bit="1024" id="chestrig"
        tags="deep_chestrig" 
        from="Headset" priority="0" row="1" col="-2" align="Card" yoff="-14" />

  <!-- ============ 目镜槽 goggles（bit 2048） ============
       匹配 DDA 热成像/夜视目镜（thermalgoggles_t7 / gpnvg_18，tag=deep_tac_thermal），
       它们当前占据 Card（ID 卡）槽 → 迁入 2048 专属槽；
       align="Headset" + col="0" = 精确吸附原版耳机列（三槽中间位） -->
  <Slot bit="2048" id="goggles"
        tags="deep_goggles"
        from="Card" priority="0" row="1" col="0" align="Headset" yoff="-14" />

  <!-- ============ 头套槽 mask（bit 4096，原背包槽位） ============
       匹配 DDA 四款战术头套（战术头套/提花头巾/半头巾/战术护目面罩），
       它们当前穿戴在 Card（ID 卡）槽 → 迁入 4096 专属槽（col=0 基准列=ID 卡列） -->
  <Slot bit="4096" id="mask"
        tags="deep_mask"
        from="Card" priority="0" row="1" col="0" yoff="-14" />

</DeepSlotExpandeds>
