<Project>
  <PropertyGroup>
    <Libs Condition="'$(Libs)' == ''">$(MSBuildThisFileDirectory)../../.Tools/Refs</Libs>
    <ModDeployDir Condition="'$(ModDeployDir)' == ''">$(MSBuildThisFileDirectory)../../</ModDeployDir>
    <AssemblyName>AmmoLoaderSupply</AssemblyName>
    <RootNamespace>DdaAmmoSupply</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GameAssembly Condition="'$(BuildTarget)' == 'Client'">Barotrauma</GameAssembly>
    <GameAssembly Condition="'$(BuildTarget)' == 'Server'">DedicatedServer</GameAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)SharedProject/*.cs" Link="%(Filename)%(Extension)" />
    <Reference Include="$(GameAssembly)" HintPath="$(Libs)/$(PlatformName)/$(GameAssembly).dll" Private="false" />
    <Reference Include="BarotraumaCore" HintPath="$(Libs)/$(PlatformName)/BarotraumaCore.dll" Private="false" />
    <Reference Include="LuaCsForBarotraumaPlugin$(BuildTarget)" HintPath="$(Libs)/$(PlatformName)/LuaCsForBarotraumaPlugin$(BuildTarget).dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Libs)/0Harmony.dll" Private="false" />
    <Reference Include="MonoGame.Framework.Windows.NetStandard" HintPath="$(Libs)/MonoGame.Framework.Windows.NetStandard.dll" Private="false" />
    <Reference Include="XNATypes" HintPath="$(Libs)/XNATypes.dll" Private="false" />
    <Reference Include="System.Collections.Immutable" HintPath="$(Libs)/System.Collections.Immutable.dll" Private="false" />
  </ItemGroup>
  <Target Name="CopyFiles" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(ModDeployDir)/bin/$(BuildTarget)/$(PlatformName)/" />
  </Target>
</Project>
