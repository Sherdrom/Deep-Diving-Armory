  <Talents>
  <Talent identifier="deep_talent_separatists_soidier_moderate">
    <Icon texture="%ModDir%/Talents/shotgun.png" sheetindex="0,3" sheetelementsize="128,128"/>
    <Description tag="talentdescription.deep_talent_separatists_soidier_moderate">
    </Description>
	<!-- 数值调整 -->
	<AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveStat stattype="MaximumHealthMultiplier" value="1.3"/>
        <CharacterAbilityGiveStat stattype="MeleeAttackMultiplier" value="10"/>
		<CharacterAbilityGiveStat stattype="MeleeAttackSpeed" value="1"/>
		<CharacterAbilityGiveStat stattype="MovementSpeed" value="0.1"/>
		<CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.3"/>
		<CharacterAbilityModifyStat stattype="TeamAttackMultiplier" value="-1"/>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 抗性 -->
	<AbilityGroupInterval interval="0.1" >
      <Abilities>
		<CharacterAbilityModifyResistance resistanceid="stun" multiplier="0.5"/>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 突击手 -->
	<AbilityGroupInterval interval="0.1" >
      <Conditions>
		<AbilityConditionNearbyCharacterCount distance="400" targettypes="Enemy" count="1"/>
      </Conditions>
      <Abilities>
	    <CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.3"/>
		<CharacterAbilityModifyResistance resistanceid="damage" multiplier="0.5"/>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>
  
