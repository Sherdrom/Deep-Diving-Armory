  <Talents>
  <Talent identifier="deep_talent_ghost_soidier_elite">
    <Icon texture="%ModDir%/Talents/shotgun.png" sheetindex="0,3" sheetelementsize="128,128"/>
    <Description tag="talentdescription.deep_talent_ghost_soidier_elite">
    </Description>
	<!-- 数值调整 -->
	<AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveStat stattype="MaximumHealthMultiplier" value="3"/>
        <CharacterAbilityGiveStat stattype="MeleeAttackMultiplier" value="10"/>
		<CharacterAbilityGiveStat stattype="MeleeAttackSpeed" value="1"/>
		<CharacterAbilityGiveStat stattype="MovementSpeed" value="0.6"/>
		<CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.5"/>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 攻击时降低玩家45%伤害抗性 -->
	<AbilityGroupEffect abilityeffecttype="OnAttack" >
     <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" setvalue="true" disabledeltatime="true" multiplyafflictionsbymaxvitality="true" >
              <Affliction identifier="deep_gunwound_reduce_45" strength="1.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 抗性 -->
	<AbilityGroupInterval interval="0.1" >
      <Abilities>
		<CharacterAbilityModifyResistance resistanceid="stun" multiplier="0.1"/>
		<CharacterAbilityModifyResistance resistanceid="fractures" multiplier="0"/>
		<CharacterAbilityModifyResistance resistanceid="t_amputation" multiplier="0"/>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 突击手 -->
	<AbilityGroupInterval interval="0.1" >
      <Conditions>
		<AbilityConditionNearbyCharacterCount distance="500" targettypes="Enemy" count="1"/>
      </Conditions>
      <Abilities>
		<CharacterAbilityModifyStat stattype="MaximumHealthMultiplier" value="2"/>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 多人游戏血量动态调整 -->
    <AbilityGroupInterval interval="0.1" >
      <Conditions>
		<AbilityConditionNearbyCharacterCount distance="2000" targettypes="Enemy" count="1"/>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyStat stattype="MaximumHealthMultiplier" value="1"/>
      </Abilities>
