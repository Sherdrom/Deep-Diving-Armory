    <Talent identifier="deep_elite_talent_pirate_leader_normal">
    <Icon texture="%ModDir%/Talents/shotgun.png" sheetindex="0,3" sheetelementsize="128,128"/>
    <Description tag="talentdescription.deep_elite_talent_pirate_leader_normal">
    </Description>
    <!-- 海盗精英首领天赋 -->
	<!-- 多人游戏数值调整 -->
	<AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveStat stattype="MaximumHealthMultiplier" value="1"/>
        <CharacterAbilityGiveStat stattype="MeleeAttackMultiplier" value="10"/>
		<CharacterAbilityGiveStat stattype="MeleeAttackSpeed" value="1"/>
		<CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.15"/>
		<CharacterAbilityGiveStat stattype="MovementSpeed" value="0.3"/>
		<CharacterAbilityModifyStat stattype="TeamAttackMultiplier" value="-1"/>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 抗性 -->
	<AbilityGroupInterval interval="5" >
      <Abilities>
		<CharacterAbilityModifyResistance resistanceid="stun" multiplier="0.2"/>
    <CharacterAbilityModifyResistance resistanceid="damage" multiplier="0.8"/>
		<CharacterAbilityModifyResistance resistanceid="fractures" multiplier="0"/>
		<CharacterAbilityModifyResistance resistanceid="t_amputation" multiplier="0"/>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 首领 -->
	<AbilityGroupEffect abilityeffecttype="OnDieToCharacter">
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies requiresalive="false">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" multiplyafflictionsbymaxvitality="true" >
              <Affliction identifier="deep_revengesquad_pirate" amount="120"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 暴力军阀 -->
	<AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionAttackData weapontype="handheldranged" />
        <AbilityConditionNearbyCharacterCount distance="800" targettypes="Enemy" count="2"/>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="0.2" />
      </Abilities>
    </AbilityGroupEffect>
    <!-- 首领 -->
    <!-- 首领活着时，全员获得10%移速，伤害加成,30%精度加成 -->
    <AbilityGroupInterval interval="0.9">
      <Abilities>
        <CharacterAbilityApplyStatusEffectsToAllies allowself="true" requiresalive="true" allowclientsimulation="false">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disabledeltatime="true" multiplyafflictionsbymaxvitality="true" >
              <Affliction identifier="deep_talent_pirate_leader_alive" amount="10.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffectsToAllies>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 多人游戏动态抗性调整 -->
	<AbilityGroupInterval interval="0.9" >
      <Conditions>
		<AbilityConditionNearbyCharacterCount distance="1500" targettypes="Enemy" count="2"/>
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
