  <Talents>
  <Talent identifier="deep_talent_coalition_soidier_elite">
    <Icon texture="%ModDir%/Talents/shotgun.png" sheetindex="0,3" sheetelementsize="128,128"/>
    <Description tag="talentdescription.deep_talent_coalition_soidier_elite">
    </Description>
    <!-- 士兵天赋 -->
	<!-- 数值调整 -->
	<AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveStat stattype="MaximumHealthMultiplier" value="2"/>
        <CharacterAbilityGiveStat stattype="MeleeAttackMultiplier" value="10"/>
		<CharacterAbilityGiveStat stattype="MeleeAttackSpeed" value="1"/>
		<CharacterAbilityGiveStat stattype="MovementSpeed" value="0.4"/>
		<CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.5"/>
    <CharacterAbilityModifyStat stattype="RangedSpreadReduction" value="0.5"/>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 攻击时降低玩家40%伤害抗性 -->
	<AbilityGroupEffect abilityeffecttype="OnAttack" >
     <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" setvalue="true" disabledeltatime="true" multiplyafflictionsbymaxvitality="true" >
              <Affliction identifier="deep_gunwound_reduce_40" strength="1.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 抗性 -->
	<AbilityGroupInterval interval="5" >
      <Abilities>
		<CharacterAbilityModifyResistance resistanceid="stun" multiplier="0.1"/>
		<CharacterAbilityModifyResistance resistanceid="damage" multiplier="0.7"/>
		<CharacterAbilityModifyResistance resistanceid="fractures" multiplier="0"/>
		<CharacterAbilityModifyResistance resistanceid="t_amputation" multiplier="0"/>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 突击手 -->
	<AbilityGroupInterval interval="0.9" >
      <Conditions>
		<AbilityConditionNearbyCharacterCount distance="500" targettypes="Enemy" count="1"/>
      </Conditions>
      <Abilities>
	        <CharacterAbilityModifyStat stattype="RangedAttackSpeed" value="0.3"/>
            <CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.3"/>
		    <CharacterAbilityModifyStat stattype="RangedSpreadReduction" value="-0.8"/>
      </Abilities>
    </AbilityGroupInterval>
    <!-- 多人游戏动态抗性调整 -->
	<AbilityGroupInterval interval="0.9" >
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyafflictionsbymaxvitality="true" disableDeltaTime="true" >
              <Affliction identifier="deep_enemy_resistance_balance_co" amount="10.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>


