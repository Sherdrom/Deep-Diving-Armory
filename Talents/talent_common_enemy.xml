<?xml version="1.0" encoding="utf-8"?>
<Talents>
  <Talent identifier="deep_talent_common_enemy">
    <Icon texture="Content/UI/TalentsIcons2.png" sheetindex="4,4" sheetelementsize="128,128"/>
    <Description tag="talentdescription.deep_talent_common_enemy">
    </Description>
    <!-- 敌人基础调整 -->
    <!-- 小惩罚机制：敌人在水中5s后，+50%伤害 
    <AbilityGroupInterval interval="3">
      <Conditions>
        <AbilityConditionInWater/>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.5"/>
        <CharacterAbilityModifyResistance resistanceid="stun" multiplier="0"/>
        <CharacterAbilityModifyResistance resistanceid="radiationsickness" multiplier="0"/>
      </Abilities>
    </AbilityGroupInterval>-->
    <!-- 抗性 -->
    <AbilityGroupInterval interval="1">
      <Abilities>
        <CharacterAbilityModifyStat stattype="RangedSpreadReduction" value="10"/>
        <CharacterAbilityModifyResistance resistanceid="alieninfection" multiplier="-1"/>
        <CharacterAbilityModifyResistance resistanceid="poison" multiplier="-1"/>
        <CharacterAbilityModifyResistance resistanceid="blunttrauma" multiplier="-1"/>
      </Abilities>
    </AbilityGroupInterval>
    <!-- 敌人倒地后，受到8倍伤害，方便补刀（无战无不休时生效）-->
    <AbilityGroupInterval interval="0.5">
      <Conditions>
        <AbilityConditionAboveVitality invert="true" vitalitypercentage="0"/>
        <AbilityConditionHasAffliction invert="true" afflictionidentifier="deep_contract_never_ending_battle_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyResistance resistanceid="damage" multiplier="8"/>
        <CharacterAbilityModifyResistance resistanceid="Shrapnel_residue" multiplier="8"/>
      </Abilities>
    </AbilityGroupInterval>
    <!-- 敌人开枪无法压制玩家-->
    <AbilityGroupEffect abilityeffecttype="OnAddDamageAffliction">
      <Conditions>
        <AbilityConditionCharacter targettypes="Enemy"/>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAffliction afflictionidentifiers="stun,incrementalstun,progressivestun" addedmultiplier="-1" />
      </Abilities>
    </AbilityGroupEffect>
    <!-- 敌人攻击玩家四肢时，降低枪伤 -->
    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" setvalue="true" multiplyafflictionsbymaxvitality="true" disabledeltatime="true">
              <Affliction identifier="deep_enemy_up_limbs_balance" strength="5.0"/>
              <Affliction identifier="deep_enemy_down_limbs_balance" strength="5.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
    <!-- 敌人攻击非人类敌人时，可以造成伤害 -->
    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionCharacter targettypes="Monster"/>
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" setvalue="true" multiplyafflictionsbymaxvitality="true" disabledeltatime="true">
              <Affliction identifier="deep_enemy_no_friendlyfire" strength="5.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>

    <!--降低敌人身上的aff-->
    <AbilityGroupInterval interval="1">
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyafflictionsbymaxvitality="true" setvalue="true" disabledeltatime="true">
              <Affliction identifier="deep_enemy_affliction_resistance" strength="4.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>

    <!--敌人受到攻击时会反击，平时攻击距离为1200-->
    <AbilityGroupEffect abilityeffecttype="OnAttackedResult">
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyafflictionsbymaxvitality="true">
              <Affliction identifier="deep_enemy_attacked_result" amount="1.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>

    <!-- 天神射手——5倍致命爆头 -->
    <AbilityGroupEffect abilityeffecttype="OnAddDamageAffliction">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="deep_contract_deep_diving_marksman_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAffliction afflictionidentifiers="deep_headshot_deadly,deep_headshot_deadly_irresistible" addedmultiplier="5" />
      </Abilities>
    </AbilityGroupEffect>

    <!-- 天神射手——-30%枪伤 -->
    <AbilityGroupEffect abilityeffecttype="OnAddDamageAffliction">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="deep_contract_deep_diving_marksman_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAffliction afflictionidentifiers="gunshotwound" addedmultiplier="-0.3" />
      </Abilities>
    </AbilityGroupEffect>

    <!-- 死里逃生 -->
    <AbilityGroupInterval interval="0.25">
      <Conditions>
        <AbilityConditionAboveVitality invert="true" vitalitypercentage="0"/>
        <AbilityConditionHasAffliction afflictionidentifier="deep_contract_narrow_escape_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyafflictionsbymaxvitality="true" setvalue="true" disabledeltatime="true" delay="8" stackable="false" comparison="and">
              <Conditional health="lt 50" />
              <Affliction identifier="deep_contract_narrow_escape_effect" strength="5" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>

    <!-- 束手就擒 -->
    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="deep_contract_surrender_without_fight_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" multiplyafflictionsbymaxvitality="true" setvalue="true" disabledeltatime="true">
              <Affliction identifier="deep_contract_surrender_without_fight_attack_detect" strength="5" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>

    <!-- 勇冠三军 -->
    <AbilityGroupInterval interval="0.9">
      <Conditions>
        <AbilityConditionAboveVitality vitalitypercentage="0.5" />
        <AbilityConditionHasAffliction afflictionidentifier="deep_contract_the_bravest_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyafflictionsbymaxvitality="true" setvalue="true" disabledeltatime="true" stackable="false" comparison="and">
              <Affliction identifier="deep_contract_the_bravest_detect_up_50" strength="5" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>


    <!-- 勇冠三军 -->
    <AbilityGroupInterval interval="0.9">
      <Conditions>
        <AbilityConditionAboveVitality invert="true" vitalitypercentage="0.5"/>
        <AbilityConditionHasAffliction afflictionidentifier="deep_contract_the_bravest_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyafflictionsbymaxvitality="true" setvalue="true" disabledeltatime="true" stackable="false" comparison="and">
              <Affliction identifier="deep_contract_the_bravest_detect_below_50" strength="5" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>

    <!-- 爆破专家 -->
    <AbilityGroupInterval interval="0.5">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="deep_contract_demolition_expert_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyafflictionsbymaxvitality="true" setvalue="true" disabledeltatime="true" stackable="false" comparison="and">
              <Affliction identifier="deep_chip_blaster" strength="5" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>


    <!--被帽弹头-->
    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="chip_headshot_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" multiplyafflictionsbymaxvitality="true" setvalue="true" disabledeltatime="true">
              <Affliction identifier="chip_headshot_effect" strength="100.0" />
              <Affliction identifier="chip_headshot_effect_weak" strength="100.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>

    <!--碎甲弹头-->
    <AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="chip_bodyshot_detect" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" multiplyafflictionsbymaxvitality="true" setvalue="true" disabledeltatime="true">
              <Affliction identifier="chip_bodyshot_effect_weak" strength="100.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>

    <!--紧急除颤-->
    <AbilityGroupInterval interval="0.5" maxtriggercount="1" effectdelay="1">
      <Conditions>
        <AbilityConditionHasAffliction afflictionidentifier="chip_emergency_defibrillation_detect" />
        <AbilityConditionAboveVitality invert="true" vitalitypercentage="0" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" multiplyafflictionsbymaxvitality="true" disabledeltatime="true">
              <Affliction identifier="chip_emergency_defibrillation" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>

  </Talent>
</Talents>