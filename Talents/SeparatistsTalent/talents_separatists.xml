<?xml version="1.0" encoding="utf-8"?>
  <Talents>
  <Talent identifier="deep_talent_separatists_soidier_moderate">
    <Icon texture="%ModDir%/Talents/shotgun.png" sheetindex="0,3" sheetelementsize="128,128"/>
    <Description tag="talentdescription.deep_talent_separatists_soidier_moderate">
    </Description>
    <!-- 敌人基础调整 -->
    <!-- 小惩罚机制：敌人在水中伤害3倍 -->
    <AbilityGroupInterval interval="0.1" >
      <Conditions>
        <AbilityConditionInWater/>
      </Conditions>
      <Abilities>
	    <CharacterAbilityModifyStat stattype="AttackMultiplier" value="2.0"/>
		<CharacterAbilityModifyResistance resistanceid="stun" multiplier="0"/>
		<CharacterAbilityModifyResistance resistanceid="alieninfection" multiplier="0"/>
		<CharacterAbilityModifyResistance resistanceid="radiationsickness" multiplier="0"/>
		<CharacterAbilityModifyResistance resistanceid="poison" multiplier="0"/>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 抗性 -->
	<AbilityGroupInterval interval="0.1" >
      <Abilities>
		<CharacterAbilityModifyResistance resistanceid="alieninfection" multiplier="0"/>
		<CharacterAbilityModifyResistance resistanceid="poison" multiplier="0"/>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 敌人倒地后，受到5倍伤害，方便补刀 -->
	<AbilityGroupInterval interval="0.1" >
	  <Conditions>
        <AbilityConditionAboveVitality invert="true" vitalitypercentage="0"/>
      </Conditions>
      <Abilities>
		<CharacterAbilityModifyResistance resistanceid="damage" multiplier="5"/>
		<CharacterAbilityModifyResistance resistanceid="Shrapnel_residue" multiplier="5"/>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 敌人开枪无法压制玩家-->
	<AbilityGroupEffect abilityeffecttype="OnAddDamageAffliction">
      <Conditions>
        <AbilityConditionCharacter targettypes="Enemy"/>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAffliction afflictionidentifiers="stun,incrementalstun,progressivestun" addedmultiplier="-1" />
      </Abilities>
    </AbilityGroupEffect>
	<!-- 敌人扎堆时，伤害降低 -->
	<AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionNearbyCharacterCount distance="300" targettypes="Ally" count="1"/>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="-0.1" />
      </Abilities>
    </AbilityGroupEffect>
	<AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionNearbyCharacterCount distance="300" targettypes="Ally" count="2"/>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="-0.1" />
      </Abilities>
    </AbilityGroupEffect>
	<AbilityGroupEffect abilityeffecttype="OnAttack">
      <Conditions>
        <AbilityConditionNearbyCharacterCount distance="300" targettypes="Ally" count="3"/>
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addeddamagemultiplier="-0.2" />
      </Abilities>
    </AbilityGroupEffect>
	<!-- 敌人攻击玩家四肢时，降低25%枪伤 -->
    <AbilityGroupEffect abilityeffecttype="OnAttack" >
     <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" setvalue="true" multiplyafflictionsbymaxvitality="true" disabledeltatime="true" >
              <Affliction identifier="deep_enemy_four_limbs_balance" strength="100.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
    <!-- 敌人攻击非人类敌人时，可以造成伤害 -->
    <AbilityGroupEffect abilityeffecttype="OnAttack" >
    <Conditions>
        <AbilityConditionCharacter targettypes="Monster"/>
      </Conditions>
     <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" setvalue="true" multiplyafflictionsbymaxvitality="true" disabledeltatime="true" >
              <Affliction identifier="deep_enemy_no_friendlyfire" strength="5.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>



    <!-- 分离普通敌人天赋 -->
	<!-- 数值调整 -->
	<AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveStat stattype="MaximumHealthMultiplier" value="1"/>
        <CharacterAbilityGiveStat stattype="MeleeAttackMultiplier" value="10"/>
		<CharacterAbilityGiveStat stattype="MeleeAttackSpeed" value="1"/>
		<CharacterAbilityGiveStat stattype="MovementSpeed" value="0.1"/>
		<CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.3"/>
		<CharacterAbilityModifyStat stattype="TeamAttackMultiplier" value="-1"/>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 抗性 -->
	<AbilityGroupInterval interval="0.1" >
      <Abilities>
		<CharacterAbilityModifyResistance resistanceid="stun" multiplier="0.5"/>
      </Abilities>
    </AbilityGroupInterval>
	<!-- 突击手 -->
	<AbilityGroupInterval interval="0.1" >
      <Conditions>
		<AbilityConditionNearbyCharacterCount distance="500" targettypes="Enemy" count="1"/>
      </Conditions>
      <Abilities>
	    <CharacterAbilityModifyStat stattype="RangedAttackSpeed" value="0.2"/>
		<CharacterAbilityModifyResistance resistanceid="damage" multiplier="0.5"/>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>


