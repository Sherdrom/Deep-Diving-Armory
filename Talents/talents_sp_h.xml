<?xml version="1.0" encoding="utf-8"?>
  <Talents>
  <Talent identifier="deep_talent_separatists_soidier_hard">
    <Icon texture="%ModDir%/Talents/shotgun.png" sheetindex="0,3" sheetelementsize="128,128"/>
    <Description tag="talentdescription.deep_talent_separatists_soidier_hard">
    </Description>
	<!-- 数值调整 -->
	<AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveStat stattype="MaximumHealthMultiplier" value="1.6"/>
        <CharacterAbilityGiveStat stattype="MeleeAttackMultiplier" value="10"/>
		<CharacterAbilityGiveStat stattype="MeleeAttackSpeed" value="1"/>
		<CharacterAbilityGiveStat stattype="MovementSpeed" value="0.1"/>
		<CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.3"/>
		<CharacterAbilityModifyStat stattype="TeamAttackMultiplier" value="-1"/>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 抗性 -->
	<AbilityGroupInterval interval="0.1" >
      <Abilities>
		<CharacterAbilityModifyResistance resistanceid="stun" multiplier="0.5"/>
      </Abilities>
    </AbilityGroupInterval>
    <!-- 攻击时降低玩家15%伤害抗性 -->
	<AbilityGroupEffect abilityeffecttype="OnAttack" >
     <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" setvalue="true" disabledeltatime="true" multiplyafflictionsbymaxvitality="true" >
              <Affliction identifier="deep_gunwound_reduce_15" strength="1.0"/>
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
	<!-- 突击手 -->
	<AbilityGroupInterval interval="0.1" >
      <Conditions>
		<AbilityConditionNearbyCharacterCount distance="400" targettypes="Enemy" count="1"/>
      </Conditions>
      <Abilities>
	    <CharacterAbilityModifyStat stattype="AttackMultiplier" value="0.4"/>
		<CharacterAbilityModifyResistance resistanceid="damage" multiplier="0.5"/>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>
  
