        <Conditional condition="gt 0"/>
        <Conditional pulseAmount="neq 1"/>
        <Sound file="%ModDir%/testfiles/APS/APS_Pluse.ogg" range="800" volume="0.5" loop="true"/>
      </StatusEffect>
      <StatusEffect target="This" type="Always">
        <Conditional pulseAmount="eq 1"/>
        <Sound file="%ModDir%/testfiles/APS/APS_Reload.ogg" range="800" volume="1" loop="true"/>
      </StatusEffect>
