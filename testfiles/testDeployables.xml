<?xml version="1.0" encoding="utf-8"?>
<Items>
  <Item identifier="deep_APS" category="Weapon" Scale="0.4" hideinmenus="false">
    <InventoryIcon texture="%ModDir%/testfiles/APS.png" sourcerect="152,62,205,400" origin="0.5,0.5" />
    <Sprite texture="%ModDir%/testfiles/APS.png" sourcerect="152,62,205,400" depth="0.55" origin="0.5,0.5" />
    <Body width="205" height="380" density="30" />
    <Pickable slots="Any" msg="ItemMsgPickUpSelect" />
    <LightComponent lightcolor="0,255,0,100" range="300.0" IsOn="true" castshadows="true" alphablend="true" allowingameediting="false">
      <LightTexture texture="Content/Lights/visioncircle.png" origin="0.5,0.5" />
