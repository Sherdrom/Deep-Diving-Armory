<?xml version="1.0" encoding="utf-8"?>
<Items>
  <Item identifier="deep_rpg7" subcategory="deep_launchers" category="Weapon" cargocontaineridentifier="metalcrate" tags="mediumitem,weapon,gun,gunsmith,mountableweapon,noammocount" scale="0.22" impactsoundtag="impact_metal_heavy" >
    <Fabricate suitablefabricators="deep_general_fabricator" requiredtime="10">
      <RequiredSkill identifier="weapons" level="80" />
      <RequiredItem identifier="steel_part" amount="4" />
      <RequiredItem identifier="steel_barrel" amount="3" />
      <RequiredItem identifier="carbon" amount="3" />
    </Fabricate>
    <Deconstruct time="10">
      <Item identifier="steel" amount="2" />
    </Deconstruct>
    <InventoryIcon texture="%ModDir%/weapon/launchers/launchers_45.png" sourcerect="406,6,228,221" origin="0.5,0.5" />
    <Sprite texture="%ModDir%/weapon/launchers/launchers_steel/rpg7/rpg7.png" sourcerect="13,12,673,185" depth="0.55" origin="0.5,0.5" />
    <Body width="670" height="190" density="10" />
    <Wearable slots="Bag" msg="ItemMsgEquipSelect" canbeselected="false" canbepicked="true" pickkey="Select">
      <sprite texture="%ModDir%/weapon/launchers/launchers_steel/rpg7/rpg7.png" canbehiddenbyotherwearables="false" sourcerect="13,12,673,185" depth="0.55" limb="Torso" depthlimb="LeftArm" rotation="90" scale="0.22" origin="0.55,0.8" />
      <StatValue stattype="MovementSpeed" value="-0.1" />
    </Wearable>
    <Holdable slots="RightHand+LeftHand" controlpose="true" holdpos="20,6" aimpos="12,8" handle1="90,-40" handle2="200,-30" holdangle="-30" msg="ItemMsgPickUpSelect">
    <!-- 禁用爆破物合约-->
      <StatusEffect type="OnActive" interval="0.9" targettype="This,Character" setvalue="true" comparison="and">
        <Conditional deep_contract_no_explosive_detect="gt 0.0" />
        <dropitem />
      </StatusEffect>
      <StatusEffect type="OnSecondaryUse" target="Character" SpeedMultiplier="0.5" setvalue="true" />
      <StatValue stattype="MovementSpeed" value="-0.2" />
    </Holdable>
    <RangedWeapon reload="1" weapondamagemodifier="1.0" holdtrigger="false" barrelpos="337,20" LaunchImpulse="0" spread="0" combatPriority="150" drawhudwhenequipped="true" crosshairscale="0.5" >
      <Crosshair texture="%ModDir%/weapon/sight/Launchers_Crosshairs.png" sourcerect="0,256,256,256" />
      <CrosshairPointer texture="%ModDir%/weapon/sight/Launchers_Crosshairs.png" sourcerect="256,256,256,256" />
      <!-- 筒口特效 -->
      <ParticleEmitter particle="flamethrower" particleamount="5" velocitymin="1000" velocitymax="1000" colormultiplier="229,221,215,255" />
      <ParticleEmitter particle="deep_plasmaspark" particlespersecond="15" anglemin="-20" anglemax="20" velocitymin="100" velocitymax="800" />
      <Sound file="%ModDir%/weapon/launchers/Sound/rocket_fire_1.ogg" type="OnUse" range="3000" selectionmode="Random" volume="1.5" />
      <Sound file="%ModDir%/weapon/launchers/Sound/rocket_fire_1.ogg" type="OnUse" range="3000" frequencymultiplier="0.95" volume="1.5" />
      <Sound file="%ModDir%/weapon/launchers/Sound/rocket_fire_1.ogg" type="OnUse" range="3000" frequencymultiplier="1.05" volume="1.5" />
      <StatusEffect type="OnUse" target="This" offset="-120,30">
        <Explosion range="500.0" force="-3" shockwave="true" smoke="false" flames="false" sparks="false" underwaterbubble="false" camerashake="150" />
      </StatusEffect>
      <RequiredItems tags="deep_rpg7_ammo" type="Contained" target="This" msg="ItemMsgAmmoRequired" />
      <RequiredSkill identifier="weapons" level="90" />
      <!-- 武器操作技能 -->
      <StatusEffect type="OnUse" target="Character" disabledeltatime="true" comparison="and" targetlimbs="Head,LeftHand,RightHand">
        <Conditional skillrequirement="true" weapons="lt 90" />
        <Affliction identifier="stun" strength="8" />
        <Affliction identifier="burn" strength="40" />
      </StatusEffect>
    </RangedWeapon>
    <RepairTool RepairMultiple="true" usablein="Both" range="400" barrelpos="80,-10" repairmultiple="true" RepairMultipleWalls="false" repairthroughwalls="false" repairthroughholes="true" spread="30" BarrelRotation="180" TargetForce="25">
      <ParticleEmitter particle="flamethrower" particleamount="3" velocitymin="1800" velocitymax="1800" highqualitycollisiondetection="true" />
      <StatusEffect type="OnUse" target="UseTarget" disabledeltatime="true">
        <!--an alternative is to use "limb" as target, which will lead to less damage-->
        <Affliction identifier="burn" amount="8" />
        <Affliction identifier="lacerations" amount="4" />
        <Affliction identifier="bleeding" amount="4" />
        <Affliction identifier="stun" amount="8" />
      </StatusEffect>
      <StatusEffect type="OnUse" target="Contained" targets="deep_backblast_exec" condition="-100" disabledeltatime="true"></StatusEffect>
      <RequiredItems items="deep_backblast_exec" type="Contained" />
    </RepairTool>
    <!--BACKBLAST-->
    <ItemContainer hideitems="false" capacity="1" maxstacksize="1" drawinventory="true" containedstateindicatorslot="0" removecontaineditemsondeconstruct="false" containedstateindicatorstyle="bullet">
      <SlotIcon slotindex="0" texture="%ModDir%/misc/ui.png" sourcerect="10,8,64,57" origin="0.5,0.5" />
      <Containable tags="deep_rpg7_ammo" hide="false" setactive="true" itempos="65,5" >
        <StatusEffect type="OnContaining" target="This">
          <SpawnItem identifiers="deep_backblast_exec" spawnposition="ThisInventory" />
          <Conditional ReloadTimer="lte 0.1" />
        </StatusEffect>
        <!--换弹动画-->
        <!-- 锁定弹药+弹药透明 -->
        <StatusEffect type="OnInserted" target="Contained" NonInteractable="true" delay="0.01" setvalue="true" spritecolor="255,255,255,0" />
        <!-- 弹药重新显示 -->
        <StatusEffect type="OnInserted" target="Contained" delay="1.8" setvalue="true" spritecolor="255,255,255,255" />
        <!-- 解锁弹药  -->
        <StatusEffect type="OnInserted" target="Contained" NonInteractable="false" delay="4" setvalue="true" />
        <!-- 左手拿弹药  -->
        <StatusEffect type="OnInserted" target="This" handle2="0,-200" delay="0.5" setvalue="true" />
        <!-- 向上抬起筒子  -->
        <StatusEffect type="OnInserted" target="This" holdpos="-10,8" aimpos="12,8" handle1="90,-40" holdangle="24" delay="1" setvalue="true" />
        <!-- 向下抬筒子  -->
        <StatusEffect type="OnInserted" target="This" holdpos="1,8" aimpos="12,8" handle1="90,-40" holdangle="-10" delay="3" setvalue="true" />
        <!-- 左手安装弹药  -->
        <StatusEffect type="OnInserted" target="This" handle2="300,30" delay="1.6" setvalue="true" />
        <!-- 回归常态  -->
        <StatusEffect type="OnInserted" target="This" holdpos="20,6" aimpos="12,8" handle1="90,-40" handle2="200,-30" holdangle="-30" delay="4" setvalue="true" />
        <StatusEffect type="OnInserted" target="This" condition="100" setValue="true" disabledeltatime="true" delay="4" stackable="false">
        </StatusEffect>
        <StatusEffect type="OnInserted" target="This" condition="0" setValue="true" disabledeltatime="true" delay="0.01" />
        <StatusEffect type="OnInserted" target="This" setValue="true" disabledeltatime="true" >
          <sound file="%ModDir%/weapon/launchers/Sound/rocket_re_1.ogg" type="OnUse" range="500.0" loop="false" volume="0.5" />
        </StatusEffect>
      </Containable>
    </ItemContainer>
    <ItemContainer hideitems="true" capacity="1" maxstacksize="1" drawinventory="false" removecontaineditemsondeconstruct="true" containedstateindicatorslot="0" containedstateindicatorstyle="bullet">
      <Containable items="deep_backblast_exec" depth="0.55" />
    </ItemContainer>
    <Quality>
      <QualityStat stattype="FirepowerMultiplier" value="0.05" />
    </Quality>
    <SkillRequirementHint identifier="weapons" level="90" />
    <aitarget sightrange="2500" soundrange="3000" fadeouttime="6" />
  </Item>
</Items>